+  echo '[trace_debug] SGLANG_MOE_TRACE_DIR='\"$SGLANG_MOE_TRACE_DIR\"' SGLANG_MOE_TRACE_PHASE='\"$SGLANG_MOE_TRACE_PHASE\"' SGLANG_MOE_TRACE_FLUSH_INTERVAL_SEC='\"$SGLANG_MOE_TRACE_FLUSH_INTERVAL_SEC\" >> \"$LOG_FILE\"; \
